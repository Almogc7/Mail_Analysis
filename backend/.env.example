# Path to your local IOC_Enricher repo checkout, used for Module 3 enrichment.
# Leave unset to use the default (assumes IOC_Enricher is a sibling of this repo, i.e.
# <projects>/IOC_Enricher next to <projects>/Mail_Analysis). Only set this if your checkout
# lives somewhere else -- note a relative path here is resolved from the process's cwd.
# IOC_ENRICHER_PATH=

# Mail_Analysis's own copies of these keys (kept separate from IOC_Enricher's .env).
VT_API_KEY=
URLSCAN_API_KEY=
THREATFOX_API_KEY=
MALWAREBAZAAR_API_KEY=

# For Module 6 (Gemini second-opinion layer).
GOOGLE_API_KEY=
