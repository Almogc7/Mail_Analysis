# Provider API keys for the lookup sources (app/enrichment/providers). Each is optional: a source
# without a key reports "disabled" and its indicators are shown as UNKNOWN ("check by hand"), never clean.
# Use your own free VirusTotal key (4 lookups a minute, 500 a day); ThreatFox and MalwareBazaar need a free
# abuse.ch Auth-Key.
VT_API_KEY=
URLSCAN_API_KEY=
THREATFOX_API_KEY=
MALWAREBAZAAR_API_KEY=

# For Module 6 (Gemini second-opinion layer; off unless LLM_ENABLED is set).
GOOGLE_API_KEY=
# IOC_CHAT_MODEL=gemini-flash-latest

# Optional lookup tunables (defaults shown): per-request timeout, retries after a failure, back-off between retries.
# IOC_TIMEOUT_SECONDS=20
# IOC_MAX_RETRIES=2
# IOC_RETRY_BACKOFF_SECONDS=1.0
# Risk-number weights can be overridden too (IOC_VT_MALICIOUS_WEIGHT, IOC_THREATFOX_MATCH_BONUS, IOC_URLSCAN_HIT_LOW_BONUS ...;
# see app/enrichment/providers/scoring.py). Leave them alone unless you know why.

# --- Local-only detection configuration (JSON arrays of regexes). -----------------------------
# Put YOUR organization's real values only in backend/.env (untracked). NEVER commit real
# hostnames or banner text; the values below are generic placeholders.

# NOTE: these values are JSON, so every backslash is written twice (\\. not \.). A single backslash makes the app crash at start-up.
# Hosts whose Received-SPF / Authentication-Results headers you trust (regexes matched against the
# host named in the header, which must also appear as a hop in the Received chain). Typically your
# own inbound gateway. With this EMPTY (the default), SPF/DKIM/DMARC are reported as
# "not_evaluated": any hop, including the sender's, can add an Authentication-Results header.
# TRUSTED_RECEIVER_PATTERNS=["^mx\\.example\\.org$", "^esa[0-9]+\\.gateway\\.example\\.net$"]

# Text your mail gateway prepends to message bodies / adds to subjects, so it is not scored as
# the sender's content. A banner injected before a mid-document <!DOCTYPE> is stripped
# automatically; these cover the rest.
# GATEWAY_BANNER_PATTERNS=["external sender warning[^.]*\\."]
# GATEWAY_SUBJECT_TAG_PATTERNS=["\\[REPORTED-PHISH\\]\\s*"]

# Organisation-specific brand entries (e.g. your employer) live in an UNTRACKED JSON file,
# default backend/brands.local.json, format {"brand name": ["legit-domain.example"]}.
# LOCAL_BRANDS_FILE=

# --- Enrichment privacy (see README: "Enrichment privacy"). ------------------------------------
# Only HOSTNAMES are sent by default; the path/query of a URL never leaves unless a provider is listed here.
# ENRICHMENT_PATH_QUERY_PROVIDERS=[]
# Providers that are never called (their indicators are reported UNKNOWN, never clean):
# valid names are virustotal, urlscan, threatfox, malwarebazaar.
# ENRICHMENT_DISABLED_PROVIDERS=[]
# hostname (default) or registrable (send only example.co.uk for a.b.example.co.uk)
# ENRICHMENT_GRANULARITY=hostname
# Organisation-specific shared platforms (same JSON format as backend/app/enrichment/shared_platforms.json),
# e.g. your own SharePoint tenant. Keep this file untracked.
# SHARED_PLATFORMS_EXTRA_FILE=

# --- LLM second opinion: OFF by default. Nothing is sent to an external model unless this is on. ------
# When on, only the verdict, numbers and finding TITLES are sent, with addresses/hostnames/URLs/file names/
# IPs/internal-looking names replaced by placeholders and mapped back locally.
# LLM_ENABLED=1

# --- Analyst feedback log (SQLite, hashes/verdicts/signal names only; gitignored) --------------------
# FEEDBACK_DB=

# --- Eval only (tests/eval.py): the CONFIGURED trust mode ---------------------------------------------
# JSON array of host regexes whose Authentication-Results / Received-SPF the eval trusts in CONFIGURED mode.
# Unset = trust every header that names a hop in the chain. Keep real values here, never in the repo.
# EVAL_CONFIGURED_TRUSTED_RECEIVERS=[".*"]

# Known senders: registrable domains whose mail you positively recognise. A "benign" (no indicators found) verdict needs
# a sender on this list in addition to verified authentication. Untracked JSON, empty by default:
#   {"domains": ["example.com"]}
# Default path backend/known_senders.local.json; override here. Without it nothing can be cleared.
# KNOWN_SENDERS_FILE=
