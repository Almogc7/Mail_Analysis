#!/bin/sh
# Enable once per clone:  git config core.hooksPath .githooks
# Blocks commits that contain (1) internal strings / unapproved IPs / real-looking emails in test
# fixtures (scripts/check_fixtures.py) or (2) stray control characters in any text file
# (scripts/check_control_chars.py). Both checks always run so one failure never hides the other.
root="$(git rev-parse --show-toplevel)"
py="$root/backend/.venv/Scripts/python.exe"
[ -x "$py" ] || py="$root/backend/.venv/bin/python"
[ -x "$py" ] || py="$(command -v python3 || command -v python)"
status=0
"$py" "$root/scripts/check_fixtures.py" --staged || status=1
"$py" "$root/scripts/check_control_chars.py" --staged || status=1
exit $status
